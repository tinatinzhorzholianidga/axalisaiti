msgid "IO, the cybersecurity guide robot — press to hear more"
msgstr ""
"იო, კიბერუსაფრთხოების გზამკვლევი რობოტი — დააწკაპუნეთ, რომ კიდევ რამე "
"გითხრათ"

msgid "Hide IO"
msgstr "იოს დამალვა"

msgid "Show IO"
msgstr "იოს ჩვენება"

msgid ""
