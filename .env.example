# ---- Core ----------------------------------------------------------------
APP_ENV=development                  # development | testing | production
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
SITE_NAME=eLearning
SITE_URL=http://localhost:8000
DEFAULT_LOCALE=ka

# ---- Database / cache ------------------------------------------------------
DATABASE_URL=mysql+pymysql://elearning:elearning@mariadb:3306/elearning?charset=utf8mb4
REDIS_URL=redis://redis:6379/0

# ---- Sessions / security ---------------------------------------------------
SESSION_COOKIE_SECURE=true           # must be true in production
HSTS_ENABLED=false                   # enable once TLS is terminated correctly
LOGIN_MAX_FAILED=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

# ---- Mail ------------------------------------------------------------------
MAIL_SERVER=smtp.example.gov.ge
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@elearning.gov.ge
MAIL_SUPPRESS_SEND=true              # true in development

# ---- Files -----------------------------------------------------------------
UPLOAD_PATH=/var/lib/elearning/uploads
MAX_UPLOAD_MB=25

# ---- Features --------------------------------------------------------------
CYBERHERO_ENABLED=true
CYBERHERO_IO_CHAT_ENABLED=false
REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=false
INSTRUCTOR_APPROVAL_REQUIRED=true

# ---- Runtime ---------------------------------------------------------------
WORKER_COUNT=4
LOG_LEVEL=INFO
CERTIFICATE_ORG_NAME=Digital Governance Agency of Georgia

# ---- MariaDB container -----------------------------------------------------
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=elearning
MARIADB_USER=elearning
MARIADB_PASSWORD=elearning
